# Copiar estas variables al .env de la NUEVA instalación y completar sus valores.
# No copiar el .env ni APP_KEY, usuarios o contraseñas de otro cliente.
CLIENTE_CODIGO=cliente-nuevo
CLIENTE_NOMBRE="Federación de Billar del Cliente"
CLIENTE_NOMBRE_LEGAL="Federación de Billar del Cliente"
CLIENTE_SIGLA=FBC
CLIENTE_SISTEMA="Sistema Administrativo Federación de Billar del Cliente"
CLIENTE_PAIS=UY
CLIENTE_PAIS_NOMBRE=Uruguay
CLIENTE_DIRECCION="Completar dirección institucional"
CLIENTE_EMAIL=contacto@federacion.example
CLIENTE_TELEFONO="Completar teléfono institucional"
CLIENTE_WHATSAPP="Completar número internacional"
CLIENTE_WEB_URL=https://federacion.example
APP_URL=https://sistema.federacion.example
CLIENTE_ZONA_HORARIA=America/Montevideo
CLIENTE_IDIOMA=es
CLIENTE_MONEDA=UYU
CLIENTE_SIMBOLO_MONEDA='$U'
CLIENTE_DECIMALES=2
CLIENTE_SEPARADOR_DECIMAL=,
CLIENTE_SEPARADOR_MILES=.
CLIENTE_FORMATO_FECHA=d/m/Y
CLIENTE_LOGO=images/cliente/logo.png
CLIENTE_PIE_DOCUMENTOS=images/cliente/pie-pagina.png
CLIENTE_FAVICON=images/cliente/favicon.png
CLIENTE_COLOR_MARCA="#d97706"
# Ruta absoluta SOLO si la carpeta publicada no coincide con public/ ni ../public_html.
# CLIENTE_RAIZ_PUBLICA=/ruta/absoluta/public_html
# APP_TIMEZONE=UTC conserva el almacenamiento horario de la instalación original.
APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
MAIL_FROM_NAME="Federación de Billar del Cliente"
# Completar DB_*, MAIL_* y SESSION_* de esta instalación en su propio .env.
# Los datos del proveedor tienen valores predeterminados en config/cliente.php.
